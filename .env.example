# ---------------------------------------------------------------------------
# Copie este arquivo para .env e preencha. NUNCA publique o .env.
# ---------------------------------------------------------------------------

# Token entregue pelo @BotFather (/newbot)
BOT_TOKEN=123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKKlll

# Username do bot, sem @ (ex.: MeuLeitorBot)
BOT_USERNAME=MeuLeitorBot

# Short name do Mini App criado com /newapp no @BotFather
MINIAPP_SHORT_NAME=leitor

# URL pública HTTPS onde este servidor está acessível (sem barra no final).
# É a mesma URL cadastrada no /newapp. Ex.: https://abc123.ngrok-free.app
PUBLIC_URL=https://seu-dominio.exemplo.com

# ID numérico do canal (começa com -100...) ou @username do canal público
CHANNEL_ID=-1001234567890

# Opcional: IDs de usuários (separados por vírgula) que podem abrir os PDFs.
# Se vazio, qualquer pessoa com o link pode ver.
# O PRIMEIRO ID também é considerado o dono do bot (se OWNER_ID estiver vazio).
ALLOWED_USER_IDS=

# Opcional: seu user ID (dono). Recebe avisos de erro e pode usar os comandos administrativos.
OWNER_ID=

# ---- Opcionais avançados ----
# DB_PATH=data/leitor.db
# CACHE_DIR=data/cache
# CACHE_MAX_MB=300
# INIT_DATA_MAX_AGE=86400
# RUN_BOT=true
# LOG_LEVEL=INFO
# PORT=8000
